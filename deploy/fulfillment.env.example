# Keep this file outside the repository in production:
# /etc/woo-analysis/fulfillment.env (root:root, mode 0600)
WMS_SALT=
WMS_BASE_URL=http://cod.kuasuda.com/apicall

# The supplier currently documents plain HTTP. Leave disabled unless the
# security exception has been explicitly accepted for this integration.
WMS_ALLOW_INSECURE_HTTP=0

# Independent token for a future supplier callback; do not reuse WMS_SALT.
WMS_WEBHOOK_TOKEN=

# New Poland warehouse: HuaLei/SZ56T legacy form API.
SZ56T_ORDER_BASE_URL=http://175.178.192.240:8082
SZ56T_PRINT_BASE_URL=http://175.178.192.240:8089
SZ56T_USERNAME=
SZ56T_PASSWORD=
# Separate header value used by /logistics/api order.cancel.
SZ56T_CANCEL_AUTH=

# The supplier currently exposes both services over plain HTTP. Keep blocked
# until the production endpoint/security exception is explicitly approved.
SZ56T_ALLOW_INSECURE_HTTP=0
