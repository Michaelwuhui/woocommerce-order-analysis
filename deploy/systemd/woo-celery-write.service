[Unit]
Description=Woo Analysis Celery serial database writer
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/www/wwwroot/woo-analysis
EnvironmentFile=/etc/woo-analysis/woo-analysis.env
Environment=PYTHONUNBUFFERED=1
Environment=WOO_DB_POOL_MAX=1
Environment=WOO_DB_APPLICATION_NAME=woo-celery-write
ExecStart=/www/wwwroot/woo-analysis/venv/bin/python -m celery -A celery_app:celery_app worker --queues=sync_write --concurrency=1 --pool=prefork --prefetch-multiplier=1 --hostname=write@%%h --loglevel=INFO --logfile=/var/log/woo-analysis/celery-write.log --pidfile=/run/woo-analysis/celery-write.pid --max-tasks-per-child=500
Restart=always
RestartSec=5
TimeoutStopSec=360
KillSignal=SIGTERM
RuntimeDirectory=woo-analysis
RuntimeDirectoryMode=0750
LogsDirectory=woo-analysis
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/woo-analysis /run/woo-analysis
UMask=0027

[Install]
WantedBy=multi-user.target
