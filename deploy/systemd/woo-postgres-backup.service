[Unit]
Description=Woo Analysis verified PostgreSQL backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/www/wwwroot/woo-analysis
EnvironmentFile=/etc/woo-analysis/woo-analysis.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/www/wwwroot/woo-analysis/venv/bin/python /www/wwwroot/woo-analysis/backup_db.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/backups/woo-orders
UMask=0077
