[Unit]
Description=Woo Analysis verified daily Google Drive backup
Wants=network-online.target
After=network-online.target
OnFailure=woo-drive-backup-health.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/www/wwwroot/woo-analysis
ExecStart=/www/wwwroot/woo-analysis/venv/bin/python /www/wwwroot/woo-analysis/backup_drive.py run
TimeoutStartSec=90min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/woo-analysis-backup
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
