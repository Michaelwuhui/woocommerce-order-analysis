# 邮件中心专用订单只读 API。生产值必须由 systemd LoadCredential 或 0600 文件提供。
MAIL_CENTER_ORDER_API_TOKEN_FILE=
# 生产服务沿用受保护的 WOO_DB_BACKEND=postgres 与 WOO_DB_* 连接配置。
# 不要把密码复制到此模板。MAIL_CENTER_ORDER_DB_PATH 仅供 SQLite 离线测试。
# MAIL_CENTER_ORDER_DB_PATH=/path/to/offline-test.sqlite3
# 逗号分隔的订单来源主机白名单，不接受通配符。
MAIL_CENTER_ORDER_ALLOWED_SITES=
MAIL_CENTER_ORDER_PUBLIC_BASE_URL=https://www.cfworks.vip
