# Install as /etc/woo-analysis/woo-analysis.env with owner root:root and mode 0600.
# Never commit the real password or Flask secret.
WOO_DB_BACKEND=postgres
WOO_DB_HOST=127.0.0.1
WOO_DB_PORT=5432
WOO_DB_NAME=woo_analysis
WOO_DB_USER=woo_analysis_app
WOO_DB_PASSWORD=REPLACE_IN_PROTECTED_FILE
WOO_DB_POOL_MIN=0
WOO_DB_POOL_MAX=2
WOO_DB_POOL_TIMEOUT=10
WOO_DB_CONNECT_TIMEOUT=5
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional application-specific fallback for older deployments. If both are
# present they must match; Celery's standard variable is authoritative.
WOO_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
WOO_CELERY_VISIBILITY_TIMEOUT=3600
WOO_SYNC_CONNECT_TIMEOUT=5
WOO_SYNC_READ_TIMEOUT=30
WOO_SYNC_IPV4_ONLY=1
WOO_SYNC_HEARTBEAT_STALE_SECONDS=90
WOO_SYNC_RECOVERY_STALE_SECONDS=180
WOO_SYNC_POST_COMMIT_ACTIONS_ENABLED=1
FLASK_SECRET_KEY=REPLACE_IN_PROTECTED_FILE
