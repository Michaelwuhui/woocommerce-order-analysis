# Keep the real file outside the repository:
# /etc/woo-analysis/order-notification.env (root:root, mode 0600)

# HMAC event secret is referenced by environment-variable name.
ORDER_NOTIFICATION_EVENT_SECRET_REF=ORDER_NOTIFICATION_EVENT_SECRET
ORDER_NOTIFICATION_EVENT_SECRET=

# One-time server key used to encrypt front-end-managed WeCom webhooks in SQLite.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the value only in this root-owned 0600 file; web and worker services must share it.
ORDER_NOTIFICATION_WEBHOOK_MASTER_KEY=

# Private directory; do not put cards below the public static directory.
ORDER_NOTIFICATION_IMAGE_DIR=/var/lib/woo-analysis/order-cards
ORDER_SYSTEM_BASE_URL=https://orders.example.internal

# Embed a CJK-capable font in the deployment image or set an absolute path.
ORDER_NOTIFICATION_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Exact logged-email rendering. Verify this executable on the host before use.
ORDER_NOTIFICATION_CHROMIUM_PATH=/usr/bin/chromium
# Optional, comma-separated and reviewed image CDN hostnames only.
ORDER_NOTIFICATION_IMAGE_HOST_ALLOWLIST=

# Legacy environment-backed targets remain supported during migration. New
# targets should normally be encrypted and managed from the super-admin UI.
WECOM_TEST_ORDERS_WEBHOOK=
WECOM_PRODUCTION_ORDERS_WEBHOOK=
